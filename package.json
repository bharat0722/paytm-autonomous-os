{
  "name": "merchant-reliability-os",
  "private": true,
  "version": "0.1.0",
  "description": "Merchant Reliability OS: synthetic merchant-support command center (SYNTHETIC DEMO).",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:core": "tsx watch server/core/main.ts",
    "dev:api": "tsx watch server/workflow/entry.ts",
    "dev:web": "vite",
    "start:core": "tsx server/core/main.ts",
    "start:api": "tsx server/workflow/entry.ts",
    "seed": "tsx server/core/seed-cli.ts",
    "build": "vite build",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:core": "vitest run tests/core",
    "test:workflow": "vitest run tests/workflow",
    "test:web": "vitest run apps/web",
    "test:e2e": "playwright test",
    "smoke:live": "tsx tests/workflow/live-smoke.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.2.0",
    "express": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
