# Copy to .env and fill in local values. Never commit .env.
# All values are server-side only; the browser never sees them.

API_PORT=3001
DEMO_DB_PATH=./data/demo.sqlite
# 32+ random characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
DEMO_SESSION_SECRET=
# Independent access codes for the two demo roles (choose your own).
DEMO_OPERATOR_CODE=
DEMO_APPROVER_CODE=

# Investigator: scripted for CI/rehearsal, sarvam for the live AI run (falls back visibly if unavailable).
INVESTIGATOR_MODE=scripted
SARVAM_API_KEY=
# Current Sarvam chat model on /v2/chat/completions (sarvam-m is deprecated). Defaults to sarvam-105b.
SARVAM_MODEL=sarvam-105b
